From 19fe476d2f0af7a1b4d411466c6e9c75d15bd711 Mon Sep 17 00:00:00 2001
From: Rahul Sandhu <nvraxn@gmail.com>
Date: Mon, 3 Nov 2025 14:29:45 +0000
Subject: [PATCH 07/17] wayland: grant wayland_compositor access to
 /dev/udmabuf

For linux-dmabuf-v1: https://wayland.app/protocols/linux-dmabuf-v1

Signed-off-by: Rahul Sandhu <nvraxn@gmail.com>
---
 policy/modules/session/wayland.te | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/policy/modules/session/wayland.te b/policy/modules/session/wayland.te
index 121ac385a..8b0cc2d57 100644
--- a/policy/modules/session/wayland.te
+++ b/policy/modules/session/wayland.te
@@ -66,6 +66,15 @@ userdom_user_runtime_filetrans(wayland_compositor, wayland_runtime_t, file, "way
 userdom_user_runtime_filetrans(wayland_compositor, wayland_runtime_t, file, "wayland-8.lock")
 userdom_user_runtime_filetrans(wayland_compositor, wayland_runtime_t, file, "wayland-9.lock")
 
+# /dev/udmabuf allocator. This is for the linux-dmabuf-v1 protocol. This is a
+# fairly broad permission, and linux-dmabuf-v1 is a Wayland extension which is
+# implemented by all major compositors:
+# https://wayland.app/protocols/linux-dmabuf-v1#compositor-support
+# However, do not grant this access to wayland_client: shmem is the default way
+# for clients to share data with the compositor, and the majority of clients do
+# not make use of linux-dmabuf-v1.
+dev_rw_dma_dev(wayland_compositor)
+
 # GPU Access
 dev_rw_dri(wayland_compositor)
 
-- 
