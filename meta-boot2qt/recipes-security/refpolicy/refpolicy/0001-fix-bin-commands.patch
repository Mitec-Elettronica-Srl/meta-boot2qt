From: "benato.denis96@gmail.com" <benato.denis96@gmail.com>
Date: Fri, 12 Dec 2025 16:52:35 +0100
Subject: [PATCH 01/62] fix /bin commands

---
 policy/modules/kernel/corecommands.fc | 13 +++++++++++++
 policy/modules/system/locallogin.te   |  1 +
 2 files changed, 14 insertions(+)

diff --git a/policy/modules/kernel/corecommands.fc b/policy/modules/kernel/corecommands.fc
index a53425b0a..b91a6c8bb 100644
--- a/policy/modules/kernel/corecommands.fc
+++ b/policy/modules/kernel/corecommands.fc
@@ -147,6 +147,19 @@ ifdef(`distro_gentoo',`
 /opt/vmware/workstation/lib/lib/wrapper-gtk24\.sh -- gen_context(system_u:object_r:bin_t,s0)
 ')
 
+#
+# /bin
+#
+/bin/sh			--	gen_context(system_u:object_r:shell_exec_t,s0)
+/bin/d?ash		--	gen_context(system_u:object_r:shell_exec_t,s0)
+/bin/bash		--	gen_context(system_u:object_r:shell_exec_t,s0)
+/bin/bash2		--	gen_context(system_u:object_r:shell_exec_t,s0)
+/bin/mksh       --	gen_context(system_u:object_r:shell_exec_t,s0)
+/bin/fish		--	gen_context(system_u:object_r:shell_exec_t,s0)
+/bin/tcsh		--	gen_context(system_u:object_r:shell_exec_t,s0)
+/bin/yash		--	gen_context(system_u:object_r:shell_exec_t,s0)
+/bin/zsh.*		--	gen_context(system_u:object_r:shell_exec_t,s0)
+
 #
 # /usr
 #
diff --git a/policy/modules/system/locallogin.te b/policy/modules/system/locallogin.te
index 75ee52efd..14c699f73 100644
--- a/policy/modules/system/locallogin.te
+++ b/policy/modules/system/locallogin.te
@@ -66,6 +66,7 @@ kernel_link_key(local_login_t)
 kernel_getattr_proc(local_login_t)
 
 corecmd_list_bin(local_login_t)
+corecmd_exec_shell(local_login_t)
 # cjp: these are probably not needed:
 corecmd_read_bin_files(local_login_t)
 corecmd_read_bin_pipes(local_login_t)
