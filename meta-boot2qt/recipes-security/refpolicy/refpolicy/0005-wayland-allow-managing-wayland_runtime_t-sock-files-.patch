From d19004aecb24cb584e07e95889a089c4aad0e5e2 Mon Sep 17 00:00:00 2001
From: Rahul Sandhu <nvraxn@gmail.com>
Date: Mon, 3 Nov 2025 14:25:36 +0000
Subject: [PATCH 05/17] wayland: allow managing wayland_runtime_t sock files
 for display sock

Signed-off-by: Rahul Sandhu <nvraxn@gmail.com>
---
 policy/modules/session/wayland.te | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/policy/modules/session/wayland.te b/policy/modules/session/wayland.te
index 642459c54..0006e1cff 100644
--- a/policy/modules/session/wayland.te
+++ b/policy/modules/session/wayland.te
@@ -39,6 +39,8 @@ allow wayland_compositor wayland_client_tmpfs_type:file mmap_rw_inherited_file_p
 allow wayland_compositor wayland_client:fd use;
 allow wayland_compositor wayland_client_sandboxed:fd use;
 
+allow wayland_compositor wayland_runtime_t:sock_file manage_sock_file_perms;
+
 # Compositors may make more privileged sockets in $XDG_RUNTIME_DIR, so let's
 # hardcode in WAYLAND_DISPLAY so we can give other sockets created a higher level
 # of privilege (namebased filetransitions are not supported yet).
-- 
2.47.3

