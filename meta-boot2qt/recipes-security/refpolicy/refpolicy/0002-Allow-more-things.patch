From a20d5d1d3952993153fc2a644a1fedbeae7613d9 Mon Sep 17 00:00:00 2001
From: "benato.denis96@gmail.com" <benato.denis96@gmail.com>
Date: Mon, 15 Dec 2025 14:07:01 +0100
Subject: [PATCH 02/62] Allow more things

---
 policy/modules/kernel/filesystem.te |  3 ++-
 policy/modules/kernel/kernel.te     |  8 ++++++++
 policy/modules/system/unconfined.te | 16 ++++++++++++++++
 3 files changed, 26 insertions(+), 1 deletion(-)

diff --git a/policy/modules/kernel/filesystem.te b/policy/modules/kernel/filesystem.te
index c28efe129..45665c4a1 100644
--- a/policy/modules/kernel/filesystem.te
+++ b/policy/modules/kernel/filesystem.te
@@ -364,7 +364,8 @@ allow filesystem_unconfined_type filesystem_type:filesystem { associate getattr
 # Create/access other files. fs_type is to pick up various
 # pseudo filesystem types that are applied to both the filesystem
 # and its files.
-allow filesystem_unconfined_type filesystem_type:file { entrypoint exec_file_perms execmod manage_file_perms mounton quotaon relabel_file_perms watch watch_mount watch_reads watch_sb watch_with_perm };
+# Exclude unlabeled_t from entrypoint to comply with neverallow rule.
+allow filesystem_unconfined_type { filesystem_type -unlabeled_t }:file { entrypoint exec_file_perms execmod manage_file_perms mounton quotaon relabel_file_perms watch watch_mount watch_reads watch_sb watch_with_perm };
 allow filesystem_unconfined_type filesystem_type:lnk_file  { append execmod execute manage_lnk_file_perms map mounton open quotaon relabel_lnk_file_perms watch watch_mount watch_reads watch_sb watch_with_perm };
 allow filesystem_unconfined_type filesystem_type:sock_file { execmod execute manage_sock_file_perms map mounton quotaon relabel_sock_file_perms watch watch_mount watch_reads watch_sb watch_with_perm };
 allow filesystem_unconfined_type filesystem_type:fifo_file { execmod execute manage_fifo_file_perms map mounton quotaon relabel_fifo_file_perms watch watch_mount watch_reads watch_sb watch_with_perm };
diff --git a/policy/modules/kernel/kernel.te b/policy/modules/kernel/kernel.te
index 26578a26d..98ce12c1d 100644
--- a/policy/modules/kernel/kernel.te
+++ b/policy/modules/kernel/kernel.te
@@ -608,3 +608,11 @@ allow kern_unconfined unlabeled_t:filesystem { associate getattr mount quotaget
 allow kern_unconfined unlabeled_t:association { polmatch recvfrom sendto setcontext };
 allow kern_unconfined unlabeled_t:packet { forward_in forward_out recv relabelto send };
 allow kern_unconfined unlabeled_t:process { fork getattr getcap getpgid getrlimit getsched getsession noatsecure ptrace rlimitinh setcap setcurrent setexec setfscreate setkeycreate setpgid setrlimit setsched setsockcreate share siginh signal_perms };
+
+#============= kernel_t ==============
+allow kernel_t self:capability2 checkpoint_restore;
+allow kernel_t self:user_namespace create;
+allow kernel_t unlabeled_t:service { start status stop };
+
+#============= unlabeled_t ==============
+allow unlabeled_t tmpfs_t:filesystem associate;
diff --git a/policy/modules/system/unconfined.te b/policy/modules/system/unconfined.te
index 71e1b15ae..926cdee92 100644
--- a/policy/modules/system/unconfined.te
+++ b/policy/modules/system/unconfined.te
@@ -80,6 +80,22 @@ tunable_policy(`user_execmod_tmpfs', `
 	userdom_execmod_user_tmpfs_files(unconfined_t)
 ')
 
+gen_require(`
+	type kernel_t, unlabeled_t, user_tmpfs_t;
+	class dbus send_msg;
+')
+
+# allow limited interaction between kernel_t and unconfined_t
+allow kernel_t unconfined_t:dbus send_msg;
+allow kernel_t unconfined_t:process transition;
+allow unconfined_t kernel_t:dbus send_msg;
+
+# this is wrong and neverallow will make the build fail
+#allow unconfined_t unlabeled_t:file entrypoint;
+
+#!!!! This avc can be allowed using the boolean 'allow_execmod'
+allow unconfined_t user_tmpfs_t:file execmod;
+
 optional_policy(`
 	apache_run_helper(unconfined_t, unconfined_r)
 	apache_role(unconfined, unconfined_t, unconfined_application_exec_domain, unconfined_r)
-- 
2.47.3

