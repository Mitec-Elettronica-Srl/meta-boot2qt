<?xml version="1.0"?>
<Package>
  <Version>{{ QBSP_VERSION }}</Version>
  <ReleaseDate>{{ RELEASEDATE }}</ReleaseDate>
  <DisplayName>{{ DEPLOY_CONF_NAME }} Linux System</DisplayName>
  <Description>System image for {{ DEPLOY_CONF_NAME }} hardware</Description>
  <DownloadableArchives>image.7z</DownloadableArchives>
  <Default>false</Default>
  <Operations>
    <Operation name="Extract">
      <Argument>@TargetDir@{{ QBSP_INSTALL_PATH }}/images</Argument>
    </Operation>
  </Operations>
</Package>
